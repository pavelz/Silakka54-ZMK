#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hml: home_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Triggers on Left Side Keys

            hold-trigger-key-positions = <
                // 0 1 2 3 4 5  // 1st row left
                6 7 8 9 10 11  // 1st row right
                // 12 13 14 15 16 17  // 2nd row left
                18 19 20 21 22 23  // 2nd row right
                // 24 25 26 27 28 29  // 3rd row left
                30 31 32 33 34 35  // 3rd row right
                // 36 37 38 39 40 41 42  // 4th row left
                37 38 39 40  // 4th row left mod
                43 44 45 46 47 48 49  // 4th row right
                50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        hmr: home_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            // Triggers on Right Side Keys

            hold-trigger-key-positions = <
                0 1 2 3 4 5  // 1st row left
                // 6 7 8 9 10 11  // 1st row right
                12 13 14 15 16 17  // 2nd row left
                // 18 19 20 21 22 23  // 2nd row right
                24 25 26 27 28 29  // 3rd row left
                // 30 31 32 33 34 35  // 3rd row right
                36 37 38 39 40 41 42  // 4th row left
                // 43 44 45 46 47 48 49  // 4th row right
                45 46 47 48  // 4th row right mod
                50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        mmr: mirror_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MIRROR_MOD_RIGHT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            // Triggers on Right Side Keys

            hold-trigger-key-positions = <
                // 0 1 2 3 4 5  // 1st row left
                6 7 8 9 10 11  // 1st row right
                // 12 13 14 15 16 17  // 2nd row left
                18 19 20 21 22 23  // 2nd row right
                // 24 25 26 27 28 29  // 3rd row left
                30 31 32 33 34 35  // 3rd row right
                // 36 37 38 39 40 41 42  // 4th row left
                43 44 45 46 47 48 49  // 4th row right
                // 50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        mml: mirror_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MIRROR_MOD_LEFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            // Triggers on Left Side Keys

            hold-trigger-key-positions = <
                0 1 2 3 4 5  // 1st row left
                // 6 7 8 9 10 11  // 1st row right
                12 13 14 15 16 17  // 2nd row left
                // 18 19 20 21 22 23  // 2nd row right
                24 25 26 27 28 29  // 3rd row left
                // 30 31 32 33 34 35  // 3rd row right
                36 37 38 39 40 41 42  // 4th row left
                // 43 44 45 46 47 48 49  // 4th row right
                50 51 52 53  // thumb cluster left
                // 54 55 56 57  // thumb cluster right
            >;
        };

        mlr: mirror_layer_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MIRROR_LAYER_RIGHT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;

            // Triggers on Right Side Keys

            hold-trigger-key-positions = <
                // 0 1 2 3 4 5  // 1st row left
                6 7 8 9 10 11  // 1st row right
                // 12 13 14 15 16 17  // 2nd row left
                18 19 20 21 22 23  // 2nd row right
                // 24 25 26 27 28 29  // 3rd row left
                30 31 32 33 34 35  // 3rd row right
                // 36 37 38 39 40 41 42  // 4th row left
                43 44 45 46 47 48 49  // 4th row right
                // 50 51 52 53  // thumb cluster left
                54 55 56 57  // thumb cluster right
            >;
        };

        mll: mirror_layer_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MIRROR_LAYER_LEFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;

            // Triggers on Left Side Keys

            hold-trigger-key-positions = <
                0 1 2 3 4 5  // 1st row left
                // 6 7 8 9 10 11  // 1st row right
                12 13 14 15 16 17  // 2nd row left
                // 18 19 20 21 22 23  // 2nd row right
                24 25 26 27 28 29  // 3rd row left
                // 30 31 32 33 34 35  // 3rd row right
                36 37 38 39 40 41 42  // 4th row left
                // 43 44 45 46 47 48 49  // 4th row right
                50 51 52 53  // thumb cluster left
                // 54 55 56 57  // thumb cluster right
            >;
        };

        dbt_btallclear: dbt_btallclear {
            compatible = "zmk,behavior-tap-dance";
            label = "DBT_BTALLCLEAR";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_CLR_ALL>;
        };

        dbt_btclearone: dbt_btclearone {
            compatible = "zmk,behavior-tap-dance";
            label = "DBT_BTCLEARONE";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_CLR>;
        };
    };

    combos {
        compatible = "zmk,combos";

        btlayer {
            bindings = <&mo 5>;
            key-positions = <55 56 57>;
        };

        macronavigate {
            bindings = <&mo 5>;
            key-positions = <10 11>;
        };
    };

    macros {
        ctrl_a_and: ctrl_a_and {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LCTRL &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;

            label = "CTRL_A_AND";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&lt 8 GRAVE     &kp N1        &kp N2       &kp N3        &kp N4            &kp N5                        &kp N6        &kp N7         &kp N8           &kp N9         &kp N0           &kp BACKSPACE
&kp TAB         &kp Q         &kp W        &kp E         &kp R             &kp T                         &kp Y         &kp U          &kp I            &kp O          &kp P            &kp BACKSLASH
&kp LCTRL       &lt 6 A       &kp S        &kp D         &kp F             &kp G                         &kp H         &kp J          &kp K            &kp L          &kp SEMI         &kp SQT
&kp LEFT_SHIFT  &hml LCTRL Z  &hml LALT X  &hml LCMD C   &hml LSHFT V      &kp B         &none    &none  &kp N         &hmr RSHFT M   &hmr RCMD COMMA  &hmr RALT DOT  &hmr RCTRL FSLH  &kp ESC
                                           &mll 1 SPACE  &kp LEFT_COMMAND  &mll 4 SPACE  &none    &none  &mlr 7 ENTER  &kp RIGHT_ALT  &mlr 1 SPACE
            >;
        };

        layer_esab {
            display-name = "esab";
            bindings = <
&kp MINUS         &kp N0            &kp N9         &kp N8           &kp N7                      &kp N6                        &kp N5        &kp N4               &kp N3       &kp N2       &kp N1        &kp GRAVE
&kp EQUAL         &kp P             &kp O          &kp I            &kp U                       &kp Y                         &kp T         &kp R                &kp E        &kp W        &kp Q         &kp ESCAPE
&kp SINGLE_QUOTE  &kp SEMICOLON     &kp L          &kp K            &kp J                       &kp H                         &kp G         &kp F                &kp D        &kp S        &kp A         &kp LEFT_BRACKET
&kp BACKSLASH     &hml RCTRL SLASH  &hml RALT DOT  &hml RCMD COMMA  &hml RSHFT M                &kp N         &none    &none  &kp B         &hmr LSHFT V         &hmr LCMD C  &hmr LALT X  &hmr LCTRL Z  &kp RIGHT_BRACKET
                                                   &trans           &mml RIGHT_SHIFT BACKSPACE  &mll 3 ENTER  &none    &none  &mlr 3 GRAVE  &mmr LEFT_SHIFT TAB  &trans
            >;
        };

        layer_fn {
            display-name = "fn";
            bindings = <
&kp F1                &kp F2                &kp F3                             &kp F4           &kp F5               &kp F6                        &kp F7      &kp F8            &kp F9          &kp F10          &kp F11       &kp F12
&kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_SEARCH  &kp C_VOICE_COMMAND  &kp K_CANCEL                  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT      &kp C_MUTE       &kp C_VOL_DN  &kp C_VOL_UP
&bt BT_SEL 0          &bt BT_SEL 2          &none                              &kp UP           &none                &bt BT_SEL 4                  &trans      &mkp LCLK         &mmv MOVE_UP    &mkp RCLK        &trans        &studio_unlock
&bt BT_SEL 1          &bt BT_SEL 3          &kp LEFT                           &kp DOWN         &kp RIGHT            &bt BT_CLR    &none    &none  &trans      &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans        &trans
                                                                               &mo 3            &trans               &trans        &none    &none  &trans      &trans            &mo 3
            >;
        };

        layer_nf {
            display-name = "nf";
            bindings = <
&kp F12         &kp F11       &kp F10         &kp F9          &kp F8           &kp F7                      &kp F6        &kp F5               &kp F4           &kp F3                             &kp F2        &kp F1
&kp C_VOL_UP    &kp C_VOL_DN  &kp C_MUTE      &kp C_NEXT      &kp C_PP         &kp C_PREV                  &kp K_CANCEL  &kp C_VOICE_COMMAND  &kp C_AC_SEARCH  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_BRI_UP  &kp C_BRI_DN
&studio_unlock  &trans        &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &trans                      &bt BT_SEL 4  &none                &kp UP           &none                              &bt BT_SEL 2  &bt BT_SEL 0
&trans          &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans      &none    &none  &bt BT_CLR    &kp LEFT             &kp DOWN         &kp RIGHT                          &bt BT_SEL 3  &bt BT_SEL 1
                                              &trans          &trans           &trans      &none    &none  &trans        &trans               &trans
            >;
        };

        layer_4 {
            bindings = <
&kp F12     &kp F1         &kp F2          &kp F3                &kp F4                &kp F5                                   &kp F6          &kp F7          &kp F8           &kp F9           &kp F10        &kp F11
&kp UNDER   &kp KP_DIVIDE  &kp BACKSLASH   &mkp MCLK             &mkp LCLK             &mkp RCLK                                &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp LCLK      &kp F12
&kp SEMI    &kp ASTRK      &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp LEFT_BRACKET      &kp RIGHT_BRACKET                        &kp LEFT        &kp DOWN        &kp UP           &kp RIGHT        &kp PAGE_UP    &kp C_AC_HOME
&kp PERIOD  &kp EQUAL      &kp MINUS       &kp PLUS              &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP     &msc SCRL_RIGHT  &kp PAGE_DOWN  &kp END
                                           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans                 &trans    &trans  &kp K_MUTE      &kp C_VOL_DN    &kp C_VOLUME_UP
            >;
        };

        bt_layer {
            bindings = <
&bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans                           &trans        &trans        &trans         &trans  &trans  &trans
&trans           &trans           &trans        &trans        &trans        &trans                           &trans        &trans        &trans         &trans  &trans  &trans
&trans           &trans           &trans        &trans        &trans        &trans                           &trans        &trans        &trans         &trans  &trans  &trans
&dbt_btclearone  &dbt_btallclear  &trans        &trans        &trans        &trans         &trans    &trans  &trans        &trans        &trans         &trans  &trans  &trans
                                                &trans        &trans        &kp LG(RIGHT)  &trans    &trans  &kp LG(LEFT)  &kp LA(LEFT)  &kp LA(RIGHT)
            >;
        };

        tmux {
            bindings = <
&trans         &ctrl_a_and NUMBER_1  &ctrl_a_and NUMBER_2  &ctrl_a_and NUMBER_3  &ctrl_a_and NUMBER_4  &ctrl_a_and NUMBER_5                    &trans         &trans         &trans         &trans         &trans  &trans
&trans         &trans                &ctrl_a_and W         &trans                &trans                &ctrl_a_and T                           &trans         &trans         &trans         &trans         &trans  &trans
&ctrl_a_and Z  &trans                &ctrl_a_and S         &trans                &trans                &trans                                  &ctrl_a_and H  &ctrl_a_and J  &ctrl_a_and K  &ctrl_a_and L  &trans  &trans
&trans         &ctrl_a_and Z         &trans                &ctrl_a_and C         &trans                &trans                &trans    &trans  &trans         &trans         &trans         &trans         &trans  &trans
                                                           &trans                &trans                &trans                &trans    &trans  &trans         &trans         &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans    &trans        &trans     &kp LG(LEFT)   &kp LG(RIGHT)
&trans  &trans  &trans  &trans  &trans  &trans                    &trans    &trans    &trans        &trans     &kp LA(LEFT)   &kp LA(RIGHT)
&trans  &trans  &trans  &trans  &trans  &trans                    &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp PAGE_UP    &kp HOME
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans        &trans     &kp PAGE_DOWN  &kp END
                        &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans
            >;
        };

        misc {
            bindings = <
&trans  &trans  &trans  &kp LA(LG(F5))  &trans         &trans                                &trans          &trans                &trans                &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans         &trans                                &trans          &trans                &trans                &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans         &trans                                &trans          &trans                &trans                &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans         &trans              &trans    &trans  &trans          &trans                &trans                &trans  &trans  &trans
                        &kp LA(LEFT)    &kp LA(RIGHT)  &kp LS(LC(LG(F4)))  &trans    &trans  &kp LG(LS(F5))  &kp LS(LA(C_VOL_DN))  &kp LS(LA(C_VOL_UP))
            >;
        };
    };
};
